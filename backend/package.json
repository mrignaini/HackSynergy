{
  "name": "shramikk-backend",
  "version": "1.0.0",
  "description": "SHRAMIKK Backend Foundation",
  "main": "dist/server.js",
  "scripts": {
    "dev": "node node_modules/ts-node-dev/lib/bin.js --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "prisma:generate": "node node_modules/prisma/build/index.js generate",
    "prisma:migrate": "node node_modules/prisma/build/index.js migrate dev",
    "prisma:migrate:status": "node node_modules/prisma/build/index.js migrate status",
    "prisma:seed": "node node_modules/prisma/build/index.js db seed"
  },
  "prisma": {
    "seed": "node node_modules/ts-node/dist/bin.js prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.4",
    "prisma": "^6.4.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.3"
  }
}
