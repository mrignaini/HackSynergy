# Neon PostgreSQL connection URL (do not use local PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_URL=

# Backend configuration
PORT=5000
NODE_ENV=development

# CORS configuration
FRONTEND_URL=http://localhost:5173

# JWT Authentication
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Stripe Payment Gateway (Optional - for live/test Stripe payments)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

